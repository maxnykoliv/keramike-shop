# Скопіюйте в .env для локальної розробки. У Railway ті самі змінні задаються в налаштуваннях сервісу.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=true
DATABASE_URL=postgres://keramike:keramike@localhost:5432/keramike
# Порожньо — кеш у пам'яті, задачі Celery виконуються одразу (зручно без Docker).
# З Redis: redis://localhost:6379/0
REDIS_URL=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
SITE_URL=http://localhost:3000
API_URL=http://localhost:8000
# Спільні секрети із сайтом на Vercel (там вони звуться BFF_SECRET і REVALIDATE_SECRET).
# BFF_SHARED_SECRET — лише з ним API вірить IP клієнта, який передає сайт.
# REVALIDATE_SECRET — бекенд оновлює сторінки каталогу одразу після змін в адмінці.
BFF_SHARED_SECRET=
REVALIDATE_SECRET=
# Скільки проксі перед Django дописують X-Forwarded-For: 0 локально, 1 на Railway (типово в prod).
TRUSTED_PROXY_COUNT=0

# Cloudflare R2. Порожньо — файли зберігаються локально в media/.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# fake — для розробки; liqpay — для бойового режиму.
PAYMENT_PROVIDER=fake
PAYMENT_PUBLIC_KEY=
PAYMENT_PRIVATE_KEY=dev-private-key

NOVA_POSHTA_API_KEY=
# Бот входу для клієнтів (окремий від бота сповіщень). Після деплою: manage.py telegram_set_webhook
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_LOGIN_BOT_USERNAME=  
TELEGRAM_WEBHOOK_SECRET=
# console — код у логах для розробки; згодом viber, sms
AUTH_CODE_CHANNELS=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Keramike <noreply@localhost>
TURNSTILE_SECRET_KEY=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
BACKUP_ENABLED=false
LOG_JSON=false
