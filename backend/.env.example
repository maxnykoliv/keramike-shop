# Copy to .env for local development. On Railway, set the same variables in the service settings.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=true
DATABASE_URL=postgres://keramike:keramike@localhost:5432/keramike
# Empty: in-memory cache, Celery tasks run synchronously (handy without Docker).
# With Redis: redis://localhost:6379/0
REDIS_URL=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
SITE_URL=http://localhost:3000
API_URL=http://localhost:8000
# Secrets shared with the site on Vercel (named BFF_SECRET and REVALIDATE_SECRET there).
# BFF_SHARED_SECRET: the API trusts the client IP sent by the site only with this secret.
# REVALIDATE_SECRET: lets the backend refresh catalog pages right after admin changes.
BFF_SHARED_SECRET=
REVALIDATE_SECRET=
# How many proxies in front of Django append to X-Forwarded-For: 0 locally, 1 on Railway (prod default).
TRUSTED_PROXY_COUNT=0

# Cloudflare R2. Empty: files are stored locally in media/.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# fake for development; liqpay for production.
PAYMENT_PROVIDER=fake
PAYMENT_PUBLIC_KEY=
PAYMENT_PRIVATE_KEY=dev-private-key

NOVA_POSHTA_API_KEY=
# Customer login bot (separate from the notification bot). After deploy: manage.py telegram_set_webhook
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_LOGIN_BOT_USERNAME=  
TELEGRAM_WEBHOOK_SECRET=
# console prints the code to the logs for development; viber and sms later
AUTH_CODE_CHANNELS=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Keramike <noreply@localhost>
TURNSTILE_SECRET_KEY=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
BACKUP_ENABLED=false
LOG_JSON=false
