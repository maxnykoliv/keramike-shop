# Copy to .env.local for local development. On Vercel, set the same variables in Project Settings.

# URLs of the API (Django on Railway) and of the site itself, without a trailing slash.
API_URL=http://127.0.0.1:8000
SITE_URL=http://localhost:3000

# Must match the backend's BFF_SHARED_SECRET and REVALIDATE_SECRET.
BFF_SECRET=
REVALIDATE_SECRET=

# Public variables are baked into the build: changing them requires a new deploy.
# Cloudflare R2 file URL (the backend's AWS_S3_CUSTOM_DOMAIN with https://).
NEXT_PUBLIC_MEDIA_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SHOP_PHONE=
NEXT_PUBLIC_SHOP_EMAIL=
NEXT_PUBLIC_SHOP_ADDRESS=
NEXT_PUBLIC_SHOP_HOURS=
