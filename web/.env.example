# Скопіюйте в .env.local для локальної розробки. На Vercel ті самі змінні задаються в Project Settings.

# Адреса API (Django на Railway) і самого сайту, без скісної риски в кінці.
API_URL=http://127.0.0.1:8000
SITE_URL=http://localhost:3000

# Мають збігатися з BFF_SHARED_SECRET і REVALIDATE_SECRET бекенду.
BFF_SECRET=
REVALIDATE_SECRET=

# Публічні змінні вбудовуються в збірку: після зміни потрібен новий деплой.
# Адреса файлів у Cloudflare R2 (AWS_S3_CUSTOM_DOMAIN бекенду з https://).
NEXT_PUBLIC_MEDIA_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SHOP_PHONE=
NEXT_PUBLIC_SHOP_EMAIL=
NEXT_PUBLIC_SHOP_ADDRESS=
NEXT_PUBLIC_SHOP_HOURS=
